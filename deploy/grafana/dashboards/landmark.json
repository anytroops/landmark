{
 "uid": "landmark",
 "title": "Landmark cluster",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Identify rate by result",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (code, partial) (rate(landmark_coordinator_identify_seconds_count[$__rate_interval]))",
     "legendFormat": "{{code}} partial={{partial}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Identify latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(landmark_coordinator_identify_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(landmark_coordinator_identify_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p99",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.999, sum by (le) (rate(landmark_coordinator_identify_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p99.9",
     "refId": "C"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Replica available (verified, healthy, not ejected)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "landmark_coordinator_replica_available",
     "legendFormat": "p{{partition}} {{replica}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Shard attempts by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (outcome) (rate(landmark_coordinator_shard_attempts_total[$__rate_interval]))",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Retries and ejections",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(landmark_coordinator_retries_total[$__rate_interval])",
     "legendFormat": "retries/s",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(landmark_coordinator_ejections_total[$__rate_interval]))",
     "legendFormat": "ejections",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "In-flight searches per replica",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "landmark_coordinator_replica_outstanding",
     "legendFormat": "p{{partition}} {{replica}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Shard search latency p99 by partition",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le, partition) (rate(landmark_shard_search_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p{{partition}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Shard queue wait p99 by partition",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le, partition) (rate(landmark_shard_queue_wait_seconds_bucket[$__rate_interval])))",
     "legendFormat": "p{{partition}}",
     "refId": "A"
    }
   ]
  }
 ],
 "tags": [
  "landmark"
 ]
}
